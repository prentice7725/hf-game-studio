{
  "$comment": "실험 카드(design/experiments/EXP-NNN-<slug>.json). scripts/experiment.mjs lint가 이 스키마와 스키마로 못 적는 규칙(섹션 존재, 칸과 측정의 짝, 범위 겹침)을 본다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "question", "sot_anchor", "origin", "hypothesis", "falsified_if", "rung", "measures", "scope", "budget"],
  "properties": {
    "id": {"type": "string", "pattern": "^EXP-[0-9]{3}$"},
    "question": {"type": "string", "minLength": 10},
    "sot_anchor": {"type": "object"},
    "origin": {"type": "string", "minLength": 3},
    "research_refs": {"type": "array", "items": {"type": "string", "pattern": "^RQ-[0-9]{3}:F[0-9]+$"}},
    "hypothesis": {"type": "string", "minLength": 10},
    "falsified_if": {"type": "string", "minLength": 10},
    "rung": {"enum": ["sim", "prototype", "godot"]},
    "builds_on": {"type": "array", "items": {"type": "string", "pattern": "^EXP-[0-9]{3}$"}},
    "skipped_rungs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"sim": {"type": "string", "minLength": 10}, "prototype": {"type": "string", "minLength": 10}}
    },
    "measures": {"type": "array", "minItems": 1, "x-uniqueBy": "id", "items": {"$ref": "#/$defs/measure"}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 5}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "properties": {"paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
    },
    "invariants": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {"type": "integer", "minimum": 1},
        "restarts": {"type": "integer", "minimum": 0},
        "asset_runs": {"type": "integer", "minimum": 0},
        "consult_calls": {"type": "integer", "minimum": 0}
      }
    },
    "commit": {"enum": ["branch", "ask"]},
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "at", "measures", "next"],
      "properties": {
        "result": {"enum": ["supported", "refuted", "inconclusive"]},
        "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"},
        "measures": {"type": "object"},
        "next": {"type": "string", "minLength": 3}
      }
    }
  },
  "$defs": {
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "pattern": "^M[0-9]+$"},
        "type": {"enum": ["sim", "telemetry", "human", "scenario"]},
        "what": {"type": "string", "minLength": 5},
        "check": {"type": ["string", "array"]},
        "ask": {"type": "string", "minLength": 5}
      }
    }
  }
}
