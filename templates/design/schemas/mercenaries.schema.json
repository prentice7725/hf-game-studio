{
  "$comment": "용병 데이터 형식. 수치는 GDD의 공식 이름과 함께 관리한다.",
  "type": "object",
  "required": ["version", "mercenaries"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "mercenaries": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "name", "hire_cost", "stats"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 20},
          "hire_cost": {"type": "integer", "minimum": 0, "maximum": 100000},
          "stats": {
            "type": "object",
            "required": ["might", "wits", "grit"],
            "additionalProperties": false,
            "properties": {
              "might": {"$ref": "#/$defs/stat"},
              "wits": {"$ref": "#/$defs/stat"},
              "grit": {"$ref": "#/$defs/stat"}
            }
          },
          "portrait": {"type": "string", "pattern": "^assets/.+\\.png$"}
        }
      }
    }
  },
  "$defs": {
    "stat": {"type": "integer", "minimum": 1, "maximum": 10}
  }
}
